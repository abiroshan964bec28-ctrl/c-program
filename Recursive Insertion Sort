#include <stdio.h>

void recursiveInsertionSort(int arr[], int n) {
    if (n <= 1) return;
    
    recursiveInsertionSort(arr, n - 1);
    
    int last = arr[n - 1];
    int j = n - 2;
    while (j >= 0 && arr[j] > last) {
        arr[j + 1] = arr[j];
        j--;
    }
    arr[j + 1] = last;
}

int main() {
    int arr[] = {3, 8, 2, 5, 1, 4};
    int n = sizeof(arr) / sizeof(arr[0]);
    
    recursiveInsertionSort(arr, n);
    
    printf("Sorted array: ");
    for (int i = 0; i < n; i++) printf("%d ", arr[i]);
    return 0;
}
