

#include <stdio.h>

void moveZeroes(int arr[], int n) {
    int slow = 0; // Tracks the position for the next non-zero element

    // 'fast' scans through the entire array
    for (int fast = 0; fast < n; fast++) {
        if (arr[fast] != 0) {
            // Swap elements at fast and slow pointers
            int temp = arr[slow];
            arr[slow] = arr[fast];
            arr[fast] = temp;
            
            slow++; // Move slow pointer ahead
        }
    }
}

int main() {
    int arr[] = {0, 1, 0, 3, 12};
    int n = sizeof(arr) / sizeof(arr[0]);

    moveZeroes(arr, n);

    printf("Array after moving zeroes: ");
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}
