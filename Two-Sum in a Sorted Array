#include <stdio.h>

int hasTwoSum(int arr[], int n, int target) {
    int left = 0;
    int right = n - 1;

    while (left < right) {
        int current_sum = arr[left] + arr[right];

        if (current_sum == target) {
            printf("Pair found at indices: %d and %d (%d + %d = %d)\n", 
                    left, right, arr[left], arr[right], target);
            return 1; // Success
        }
        else if (current_sum < target) {
            left++; // Need a larger sum
        } 
        else {
            right--; // Need a smaller sum
        }
    }
    return 0; // No pair found
}

int main() {
    // Array must be sorted for this approach
    int arr[] = {2, 7, 11, 15, 20}; 
    int target = 26;
    int n = sizeof(arr) / sizeof(arr[0]);

    if (!hasTwoSum(arr, n, target)) {
        printf("No pair found that sums to %d\n", target);
    }
    return 0;
}
