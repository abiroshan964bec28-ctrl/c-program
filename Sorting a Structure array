#include <stdio.h>
#include <stdlib.h>

struct Student {
    int id;
    char name[20];
};

int compareStudents(const void *a, const void *b) {
    return ((struct Student*)a)->id - ((struct Student*)b)->id;
}

int main() {
    struct Student arr[] = {{103, "Alice"}, {101, "Bob"}, {102, "Charlie"}};
    int n = sizeof(arr) / sizeof(arr[0]);
    
    qsort(arr, n, sizeof(struct Student), compareStudents);
    
    printf("Sorted students by ID:\n");
    for (int i = 0; i < n; i++) {
        printf("ID: %d, Name: %s\n", arr[i].id, arr[i].name);
    }
    return 0;
}
